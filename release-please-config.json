{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "simple",
  "include-component-in-tag": false,
  "include-v-in-tag": true,
  "bump-minor-pre-major": true,
  "draft": true,
  "force-tag-creation": true,
  "pull-request-title-pattern": "chore: release ${version}",
  "packages": {
    ".": {
      "package-name": "tizen-sim",
      "extra-files": [
        { "type": "toml", "path": "crates/tizen-sim-cli/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "crates/tizen-sim-core/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "crates/tizen-sim-gui/Cargo.toml", "jsonpath": "$.package.version" },
        { "type": "toml", "path": "Cargo.lock", "jsonpath": "$.package[?(!@.source)].version" },
        { "type": "json", "path": "crates/tizen-sim-gui/tauri.conf.json", "jsonpath": "$.version" }
      ]
    }
  }
}
