{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tizen-sim",
  "version": "0.1.0",
  "identifier": "io.github.lucaskfp.tizen-sim",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "./dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "tizen-sim",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi", "appimage", "deb"],
    "publisher": "lucaskfp",
    "category": "DeveloperTool",
    "shortDescription": "Samsung Tizen TV web app simulator",
    "longDescription": "Runs Samsung Tizen TV web apps on the Chromium milestone their TV ships, with the TV's tizen and webapis APIs, remote control, network rules and app lifecycle.",
    "license": "MIT OR Apache-2.0",
    "homepage": "https://github.com/lucaskfp/tizen-sim",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
